{
  "name": "1688-scout-helper",
  "version": "1.0.0",
  "private": true,
  "description": "Local Playwright helper server for 1688 Scout (Express + Playwright, runs on the seller's own machine)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/playwright-helper/src/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "playwright": "^1.54.0",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
